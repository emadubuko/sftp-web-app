# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Absolute path where uploaded files/folders live. Must already exist —
# this app never creates it, it only writes into an existing directory
# (e.g. your existing SFTP upload folder). Startup fails with a clear
# error if this path doesn't exist or isn't a directory.
#
# - Running directly on a host (no Docker): point this at your existing
#   SFTP directory's real path, e.g. /home/appuser/sftp/uploads.
# - Running via docker-compose.yml: leave this as /data/storage (the
#   in-container mount point) and instead set SFTP_HOST_DIR below to your
#   existing directory's real path on the host — Compose bind-mounts it in.
STORAGE_ROOT=/data/storage

# Docker only: absolute path on the HOST to your existing SFTP upload
# directory. docker-compose.yml bind-mounts this to /data/storage inside
# the container. Must be readable/writable by UID 1004 / GID 1003
# (appuser / appgroup — see Dockerfile) on the host.
SFTP_HOST_DIR=/path/to/your/sftp/uploads

# Random string (32+ chars) used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Single admin account for the MVP.
ADMIN_USERNAME=admin

# Base64-encoded bcrypt hash of the admin password. Generate with:
#   npm run hash-password -- "your-password-here"
# (Base64-encoded, not the raw bcrypt hash, because a raw hash is full of
# literal "$" characters that Docker Compose's .env parser misinterprets
# as variable interpolation and silently corrupts.)
ADMIN_PASSWORD_HASH_B64=

# Optional: max upload size in bytes. Leave unset or 0 for unlimited.
# (If a reverse proxy in front of this app also enforces a limit, e.g.
# nginx's client_max_body_size, that limit applies first.)
MAX_UPLOAD_SIZE_BYTES=0

# Comma-separated list of allowed upload file extensions (no dots,
# case-insensitive). Uploads with any other extension are rejected.
ALLOWED_FILE_EXTENSIONS=xlsx,xls,csv,zip,doc,docx,pdf

# Set to true only if running behind a reverse proxy that terminates TLS.
TRUST_PROXY=false
